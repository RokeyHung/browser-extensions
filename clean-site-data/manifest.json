{
  "manifest_version": 3,
  "name": "Clean Site Data",
  "version": "1.0.0",
  "description": "Clear cookies, storage, IndexedDB, cache and service workers for the current website",
  "permissions": ["activeTab", "scripting", "cookies", "browsingData", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
