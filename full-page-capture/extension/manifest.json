{
  "manifest_version": 3,
  "name": "Full Page Capture",
  "version": "1.0.0",
  "description": "Capture the whole page you are looking at as one full-length, full-resolution screenshot. Nothing leaves your computer.",
  "permissions": ["activeTab", "scripting", "tabs", "storage", "unlimitedStorage", "downloads", "offscreen"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture this page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
