{
  "manifest_version": 3,
  "name": "Media Saver for Facebook",
  "version": "1.0.0",
  "description": "Save photos and videos from the Facebook post in front of you, at the best quality the page already has, with one click",
  "permissions": ["downloads", "storage", "offscreen"],
  "optional_permissions": ["notifications"],
  "host_permissions": ["*://*.facebook.com/*", "*://*.fbcdn.net/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["modules/video-pick.js", "modules/json-scan.js", "injected-harvest.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["modules/fb-selectors.js", "modules/post-context.js", "modules/image-pick.js", "modules/media-index.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "download-hovered-media": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Download the media under the cursor"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
