{
  "manifest_version": 3,
  "name": "Storage Explorer",
  "version": "1.0.2",
  "description": "Inspect and edit localStorage, sessionStorage, cookies and IndexedDB of the current site, and save storage snapshots you can restore",
  "permissions": ["tabs", "scripting", "cookies", "storage", "unlimitedStorage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
